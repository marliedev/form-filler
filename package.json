{
  "name": "form-filler",
  "description": "Fills web forms with fake data",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test-site": "vite --config test-site/vite.config.ts",
    "video:preview": "vite --config promo/video/vite.config.ts --open",
    "video:render": "tsx promo/video/render.ts",
    "video:teaser": "tsx promo/video/render.ts --mode teaser"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-vue": "^1.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "wxt": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "gsap": "3.13",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
